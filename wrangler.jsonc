{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cat-handy",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Deep links like /san-pham/:slug fall back to index.html; /api/* always reaches the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cat-handy",
      // Local dev works with this placeholder. Before deploying, run `npx wrangler d1 create cat-handy` and paste the id here.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
